# ============================================================
# On-Call Assistant - Environment Configuration
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# ============================================================

# --- Embedding API (SiliconFlow Qwen3-Embedding-8B) ---
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024

# --- LLM API (Zhipu GLM Coding Plan) ---
# IMPORTANT: GLM Coding Plan must use the dedicated coding endpoint,
# NOT the general API endpoint.
LLM_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
LLM_API_KEY=your-zhipu-coding-key
LLM_MODEL=glm-4.6

# --- Server ---
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# --- Paths ---
DATA_DIR=                     # default: <project>/data
CACHE_DIR=                    # default: <project>/.cache
